{
    "name": "marshmallow/cart",
    "description": "Framework-agnostic e-commerce cart, order and discount engine for Laravel.",
    "keywords": [
        "marshmallow",
        "laravel",
        "ecommerce",
        "cart",
        "shopping-cart"
    ],
    "homepage": "https://github.com/marshmallow-packages/ecommerce-cart",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Stef",
            "email": "stef@marshmallow.dev",
            "homepage": "https://marshmallow.dev",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "stef@marshmallow.dev"
    },
    "require": {
        "php": "^8.3",
        "ext-intl": "*",
        "illuminate/config": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/container": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "marshmallow/addressable": "^1.8",
        "marshmallow/dataset-country": "^1.3",
        "marshmallow/payable": "^4.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Marshmallow\\Ecommerce\\Cart\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Marshmallow\\Ecommerce\\Cart\\Tests\\": "tests",
            "Marshmallow\\Ecommerce\\Cart\\Database\\Factories\\": "database/factories",
            "Workbench\\App\\": "workbench/app",
            "Workbench\\Database\\Factories\\": "workbench/database/factories"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage --min=100",
        "analyse": "phpstan analyse --memory-limit=512M",
        "lint": "pint",
        "lint:check": "pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Marshmallow\\Ecommerce\\Cart\\CartServiceProvider"
            ],
            "aliases": {
                "Cart": "Marshmallow\\Ecommerce\\Cart\\Facades\\Cart"
            }
        }
    }
}
